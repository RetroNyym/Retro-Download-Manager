<?xml version="1.0" encoding="utf-8"?>
<!--
  Retro+ Download Manager - MSIX (Desktop Bridge) manifesti.
  ONEM: Partner Center'daki Publisher kimliginizle birebir ayni olmali!
  Gonderim rehberi: docs/store/GONDERIM-REHBERI.md
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="RetroPlusDownloadManager"
    Publisher="CN=RetroPlus"
    Version="1.2.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Retro+ Download Manager</DisplayName>
    <PublisherDisplayName>Retro+</PublisherDisplayName>
    <Logo>assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.17763.0"
      MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="tr-tr" />
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application
      Id="App"
      Executable="RetroDownloadManager.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Retro+ Download Manager"
        Description="Hizli parcali indirme yoneticisi; magnet ve .torrent destegiyle gelir."
        Square150x150Logo="assets\Square150x150Logo.png"
        Square44x44Logo="assets\Square44x44Logo.png"
        BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="assets\SplashScreen.png" />
      </uap:VisualElements>
      <!-- magnet: linkleri bu pakete baglanir (magnet_bagla.ps1 gerekmez) -->
      <Extensions>
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="magnet" />
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
